# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit secrets.

# ─── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ──────────────────────────────────────────────────────────────
# Individual vars are used by the postgres container (POSTGRES_* are the
# official postgres image env vars).
# In production, replace these with strong random values.
POSTGRES_USER=coasterplay
POSTGRES_PASSWORD=coasterplay
POSTGRES_DB=coasterplay

# When running from inside Docker, the hostname is the service name "postgres".
# When running Prisma CLI from the host (make db-migrate, prisma studio),
# use localhost since port 5432 is forwarded in docker-compose.yml.
# Inside Docker: hostname is the service name "postgres", port is 5432 (default).
DATABASE_URL=postgresql://coasterplay:coasterplay@postgres:5432/coasterplay
# From host (prisma studio, psql, TablePlus): use localhost and the forwarded port.
# DATABASE_URL=postgresql://coasterplay:coasterplay@localhost:4321/coasterplay

# ─── BetterAuth ──────────────────────────────────────────────────────────────
# A strong secret for encryption & hashing in Better Auth
# tip: openssl rand -base64 32
BETTER_AUTH_SECRET=secret
# Base URL where your API (and Better Auth endpoints) will live in dev
BETTER_AUTH_URL=http://localhost:3000